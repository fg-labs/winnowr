+std::unique_ptr<TreeUpdater> CreateUpdater(std::string const& name, Context const* ctx,
+                                           ObjInfo const* task, Json const& config) {
+  std::unique_ptr<TreeUpdater> up{TreeUpdater::Create(name, ctx, task)};
