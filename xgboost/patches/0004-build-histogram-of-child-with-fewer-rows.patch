+// Whether to build the right child of the i-th candidate rather than the left one.
+bool BuildRight(common::Span<bst_idx_t const> n_rows, std::size_t i, double left_hess,
+                double right_hess) {
+  if (!n_rows.empty()) {
+    return n_rows[2 * i + 1] < n_rows[2 * i];
+  }
+  return right_hess < left_hess;
