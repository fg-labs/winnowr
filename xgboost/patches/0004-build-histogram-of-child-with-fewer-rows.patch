 namespace xgboost::tree {
 /**
- * @brief Decide which node as the build node for multi-target trees.
+ * @brief Decide which child of each candidate gets its histogram built. The other child's
+ *        histogram is computed by subtracting it from the parent's.
+ *
+ * Builds the child with fewer rows, as the cost of building a histogram grows with the number of
+ * rows; ties build the left child. Without row counts, as in distributed training, where the
+ * rows are split between workers and the counts differ, builds the child with the smaller sum of
+ * Hessian, which every worker agrees on. The GPU tree method always uses the sums of Hessian.
+ *
+ * The child computed by subtraction inherits the rounding error of the parent's sums, about one
+ * ulp of the parent per bin. Choosing by rows can leave the child with little Hessian to be
+ * subtracted, where that error is large relative to its own sums, though still far below the
+ * usual `min_child_weight` and `lambda`.
+ *
+ * @param n_rows The number of rows in the left and the right child of each candidate, in that
+ *               order, or empty.
  */
 void AssignNodes(MultiTargetTreeView const &tree,
                  std::vector<CPUExpandEntry> const &valid_candidates,
-                 common::Span<bst_node_t> nodes_to_build, common::Span<bst_node_t> nodes_to_sub);
+                 common::Span<bst_idx_t const> n_rows, common::Span<bst_node_t> nodes_to_build,
+                 common::Span<bst_node_t> nodes_to_sub);
 
 /**
- * @brief Decide which node as the build node.
+ * @brief AssignNodes for trees with scalar leaves, see the overload above.
  */
 void AssignNodes(ScalarTreeView const &tree, std::vector<CPUExpandEntry> const &candidates,
-                 common::Span<bst_node_t> nodes_to_build, common::Span<bst_node_t> nodes_to_sub);
+                 common::Span<bst_idx_t const> n_rows, common::Span<bst_node_t> nodes_to_build,
+                 common::Span<bst_node_t> nodes_to_sub);
+
+/**
+ * @brief The number of rows in the left and the right child of each candidate, in that order,
+ *        summed over the pages. The rows must already be partitioned into the children.
+ */
+template <typename Partitioner, typename ExpandEntry, typename TreeView>
+[[nodiscard]] std::vector<bst_idx_t> CountChildRows(TreeView const &tree,
+                                                    std::vector<Partitioner> const &partitioners,
+                                                    std::vector<ExpandEntry> const &candidates) {
+  std::vector<bst_idx_t> n_rows(candidates.size() * 2, 0);
+  for (auto const &partitioner : partitioners) {
+    auto const &partitions = partitioner.Partitions();
+    for (std::size_t i = 0; i < candidates.size(); ++i) {
+      auto nidx = candidates[i].nid;
+      n_rows[2 * i] += partitions[tree.LeftChild(nidx)].Size();
+      n_rows[2 * i + 1] += partitions[tree.RightChild(nidx)].Size();
+    }
+  }
+  return n_rows;
+}
 
